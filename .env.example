# OpenAI — server-side only. Never put this in public/app.js.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna

# Render supplies PORT automatically in production.
PORT=3000

# Optional but REQUIRED for durable online share links.
# Create the shared_tests table using the SQL in README.md.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SHARED_TEST_EXPIRY_DAYS=30

# Website ads (Google AdSense). Publisher/slot IDs are public identifiers,
# but keep configuration in the server environment for easy deployment.
ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_SLOT_PRETEST=1234567890
